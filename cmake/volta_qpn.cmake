# Standalone tools by default. Only the separately gated, reversible
# full-model experiment may link QPN into prefill (never production default).
option(STRATA_ENABLE_VOLTA_QPN "Build standalone experimental sm_70 NVFP4 QPN tools" OFF)
option(STRATA_QPN_PREFILL_EXPERIMENTAL "Explicitly build experimental QPN full-model prefill option (off by default)" OFF)
if(STRATA_QPN_PREFILL_EXPERIMENTAL AND NOT STRATA_ENABLE_VOLTA_QPN)
  message(FATAL_ERROR "STRATA_QPN_PREFILL_EXPERIMENTAL requires STRATA_ENABLE_VOLTA_QPN=ON")
endif()
if(STRATA_ENABLE_VOLTA_QPN)
  if(NOT STRATA_ENABLE_CUDA OR STRATA_ENABLE_HIP OR STRATA_HIP_GFX906 OR STRATA_ENABLE_SYCL)
    message(FATAL_ERROR "STRATA_ENABLE_VOLTA_QPN requires the NVIDIA CUDA backend")
  endif()
  if(CMAKE_CUDA_COMPILER_VERSION VERSION_GREATER_EQUAL 13)
    message(FATAL_ERROR "Volta QPN needs CUDA 12.x (qualification target: 12.8); CUDA 13 drops sm_70")
  endif()
  if(NOT "70" IN_LIST CMAKE_CUDA_ARCHITECTURES AND NOT "70-real" IN_LIST CMAKE_CUDA_ARCHITECTURES)
    message(FATAL_ERROR "Volta QPN requires an explicit 70 or 70-real CUDA architecture")
  endif()
  add_library(strata_volta_qpn STATIC src/kernels/cuda/nvfp4_volta_qpn_decode.cu)
  set_target_properties(strata_volta_qpn PROPERTIES CUDA_ARCHITECTURES "70-real" CUDA_STANDARD 17)
  target_include_directories(strata_volta_qpn PUBLIC ${PROJECT_SOURCE_DIR}/include)
  target_compile_options(strata_volta_qpn PRIVATE $<$<COMPILE_LANGUAGE:CUDA>:--ptxas-options=-v>)
  target_link_libraries(strata_volta_qpn PUBLIC CUDA::cudart)
  if(STRATA_QPN_PREFILL_EXPERIMENTAL)
    if(NOT TARGET strata_prefill)
      message(FATAL_ERROR "Experimental QPN prefill requires strata_prefill")
    endif()
    target_link_libraries(strata_prefill PUBLIC strata_volta_qpn)
    target_compile_definitions(strata_prefill PRIVATE STRATA_QPN_PREFILL_EXPERIMENTAL=1)
    # The private R1 verifier snapshots live in strata_engine, NOT strata_prefill.
    # Only the opt-in CUDA12.8/Volta experiment compiles the graph D2H hook.
    if(TARGET strata_engine)
      target_compile_definitions(strata_engine PRIVATE STRATA_QPN_R1_VERIFY_EXPERIMENTAL=1)
    else()
      message(FATAL_ERROR "Experimental QPN R1 verification capture requires strata_engine")
    endif()
  endif()
  # Standard host-only M3 test: same verifier that the manual CUDA
  # ggml-producer parity target invokes, with deliberate corrupted D4 bytes.
  # No CUDA driver, GPU lock, model artifacts, or expert weights needed.
  if(STRATA_BUILD_TESTS)
    add_executable(nvfp4_qpn_d4_source_host_test tests/host/qpn_d4_source_check_test.cpp)
    add_test(NAME nvfp4_qpn_d4_source_host COMMAND nvfp4_qpn_d4_source_host_test)
  endif()
  # Manually selected synthetic D4 correctness target. Not registered with CTest:
  # the existing GPU lock and job-idle checks are mandatory before execution.
  if(STRATA_BUILD_TESTS)
    add_executable(nvfp4_qpn_d4_stage_parity tests/cuda/qpn_d4_stage_parity.cu)
    set_target_properties(nvfp4_qpn_d4_stage_parity PROPERTIES
      CUDA_ARCHITECTURES "70-real" CUDA_STANDARD 17)
    target_link_libraries(nvfp4_qpn_d4_stage_parity PRIVATE strata_volta_qpn CUDA::cudart)
  endif()
  # Independent ggml MMQ Q8 producer -> D4 staging parity, manual-only.
  # Do not register with CTest: requires the existing exclusive GPU lock.
  if(STRATA_BUILD_TESTS AND TARGET strata_mmq AND TARGET ggml-base)
    add_executable(nvfp4_qpn_mmq_d4_producer_parity tests/cuda/qpn_mmq_d4_producer_parity.cu)
    set_target_properties(nvfp4_qpn_mmq_d4_producer_parity PROPERTIES
      CUDA_ARCHITECTURES "70-real" CUDA_STANDARD 17)
    target_link_libraries(nvfp4_qpn_mmq_d4_producer_parity PRIVATE
      strata_volta_qpn strata_mmq strata_kernels ggml-base CUDA::cudart CUDA::cublas)
  endif()
  if(STRATA_NATIVE_EXPERTS)
    add_executable(nvfp4_volta_qpn_bench src/kernels/nvfp4_volta_qpn_bench.cpp)
    target_link_libraries(nvfp4_volta_qpn_bench PRIVATE strata_volta_qpn strata_kernels ggml-base CUDA::cudart)
    if(TARGET strata_mmq)
      add_executable(nvfp4_volta_prefill_bench src/kernels/nvfp4_volta_prefill_bench.cpp)
      target_link_libraries(nvfp4_volta_prefill_bench PRIVATE strata_volta_qpn strata_kernels strata_mmq ggml-base CUDA::cudart CUDA::cublas)
      add_executable(nvfp4_volta_mixed_bench src/kernels/nvfp4_volta_mixed_bench.cpp)
      target_link_libraries(nvfp4_volta_mixed_bench PRIVATE strata_volta_qpn strata_kernels strata_mmq ggml-base CUDA::cudart)
      add_executable(nvfp4_volta_layout_probe src/kernels/nvfp4_volta_layout_probe.cpp)
      target_link_libraries(nvfp4_volta_layout_probe PRIVATE strata_volta_qpn CUDA::cudart)
    endif()
  endif()
endif()
if(STRATA_BUILD_TESTS)
  add_executable(nvfp4_qpn_host_test tests/nvfp4_qpn_host_test.cpp)
  target_include_directories(nvfp4_qpn_host_test PRIVATE ${PROJECT_SOURCE_DIR}/include)
  add_test(NAME nvfp4_qpn_host COMMAND nvfp4_qpn_host_test)
  add_executable(qpn_prefill_policy_test tests/qpn_prefill_policy_test.cpp)
  target_include_directories(qpn_prefill_policy_test PRIVATE ${PROJECT_SOURCE_DIR}/include)
  add_test(NAME qpn_prefill_policy COMMAND qpn_prefill_policy_test)
  # Performance-first CPU staging omission predicate: always host-only,
  # independent of CUDA and the default-off experimental prefill binary.
  add_executable(qpn_mmq_early_stage_host_test tests/host/qpn_mmq_early_stage_test.cpp)
  add_test(NAME qpn_mmq_early_stage_host COMMAND qpn_mmq_early_stage_host_test)
endif()
